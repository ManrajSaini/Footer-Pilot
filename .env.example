# Copy to .env for local development. Every value here has a working dev default,
# so an empty .env is enough for Phase 0 and 1.

# dev | production. Production refuses to start with fake Google mode, dev login,
# local storage or the default secret key.
ENV=dev
LOG_LEVEL=INFO

# Public URLs. The last three default to APP_BASE_URL when left empty.
# Open the app at exactly this address: Google sign-in returns here, and the session
# cookie set on one host (127.0.0.1) is not sent to another (localhost).
APP_BASE_URL=http://127.0.0.1:8000
MARKETING_BASE_URL=
TRACKING_BASE_URL=
ASSET_BASE_URL=

# Session signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# postgres:// and postgresql:// are both accepted. Use 127.0.0.1, not localhost:
# on Windows, localhost tries IPv6 first and stalls against Docker's port mapping.
DATABASE_URL=postgresql://footerpilot:footerpilot@127.0.0.1:5432/footerpilot

# --- Google (Phase 2 onwards) ---
# real | fake. Fake mode needs no Google account: the address used at /dev/login decides
# how the fake behaves (see app/google/fake.py). Real mode needs the two service-account
# settings below.
GOOGLE_MODE=fake
# Enables /dev/login (sign in without Google). Development only.
DEV_LOGIN=false
# "Sign in with Google" web client. Its authorised redirect URI must be
# {APP_BASE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Base64-encoded service-account key JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The service account's numeric client ID, shown to admins in the setup wizard.
GOOGLE_DWD_CLIENT_ID=

# --- Image storage (Phase 3 onwards) ---
# r2 | local. Local writes to MEDIA_ROOT (default ./var/media) and serves it at /media.
# Use r2 whenever real mailboxes are involved: Gmail cannot load images from your machine.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket: its r2.dev URL, or a custom domain.
R2_PUBLIC_BASE_URL=

# --- Billing (Phase 7) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
FREE_PLAN_MAX_EMPLOYEES=5
# Text shown on the pricing page, for example "$1 per user per month".
PRICE_DISPLAY=

# --- Misc ---
SETUP_CALL_URL=
SUPPORT_EMAIL=
SENTRY_DSN=
