{# Photo: employee photo on the left, details on the right, logo under the details. #}
{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block main %}
{% set has_text = v.has_identity or v.contact_lines %}
{% set has_right = has_text or v.logo %}
{% if v.photo_url or has_right %}
<tr><td><table cellpadding="0" cellspacing="0" border="0"><tr>
{% if v.photo_url %}
<td style="vertical-align:top{% if has_right %};padding-right:14px{% endif %}">{{ m.photo(v, s) }}</td>
{% endif %}
{% if has_right %}
<td style="{{ m.text_style(s) }};vertical-align:top">
{{ m.details(v, s) }}
{% if v.logo %}<div{% if has_text %} style="padding-top:10px"{% endif %}>{{ m.logo(v) }}</div>{% endif %}
</td>
{% endif %}
</tr></table></td></tr>
{% endif %}
{% endblock %}
